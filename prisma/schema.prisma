// ==========================================
// MULTI-OWNER & ADMIN AUTHENTICATION MODELS
// ==========================================

model AdminUser {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  passwordHash      String
  avatar            String?
  role              String              @default("OWNER")
  jobTitle          String?
  phone             String?
  status            String              @default("ACTIVE") // ACTIVE, DISABLED
  salary            Float?              @default(0) // Salary in Moroccan Dirhams (MAD)
  salaryType        String?             @default("MONTHLY") // MONTHLY, COMMISSION, HOURLY
  customPermissions String?             // JSON: { granted: string[], revoked: string[] }
  lastLoginAt       DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  activities        AdminActivityLog[]
  createdTasks      AdminTask[]         @relation("CreatedTasks")
  assignedTasks     AdminTask[]         @relation("AssignedTasks")
  taskComments      AdminTaskComment[]
  notifications     AdminNotification[]
  sentMessages      AdminChatMessage[]  @relation("SentMessages")
  receivedMessages  AdminChatMessage[]  @relation("ReceivedMessages")
  createdCreatives  AdminCreative[]     @relation("CreatedCreatives")
  createdExpenses   AdminExpense[]      @relation("CreatedExpenses")

  @@index([email])
  @@index([role])
  @@index([status])
}

model AdminActivityLog {
  id          String     @id @default(cuid())
  userId      String?
  userName    String
  userEmail   String?
  action      String     // LOGIN, LOGOUT, CREATE_PRODUCT, UPDATE_PRODUCT, DELETE_PRODUCT, UPDATE_ORDER, CREATE_TASK, UPDATE_TASK, etc.
  entityType  String     // PRODUCT, ORDER, REVIEW, CUSTOMER, BRAND, USER, TASK, SYSTEM
  entityId    String?
  description String
  oldValue    String?
  newValue    String?
  ipAddress   String?
  createdAt   DateTime   @default(now())
  user        AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

// ==========================================
// MISSIONS & TASKS MODELS (GESTION DES TÂCHES)
// ==========================================

model AdminTask {
  id           String             @id @default(cuid())
  title        String
  description  String?
  priority     String             @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status       String             @default("TODO")   // TODO, IN_PROGRESS, IN_REVIEW, COMPLETED, CANCELLED
  dueDate      DateTime?
  
  createdById  String?
  creator      AdminUser?         @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  creatorName  String
  
  assignedToId String?
  assignee     AdminUser?         @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  assigneeName String?
  
  tags         String?            // e.g. "Stock, Urgent, Marketing, Commandes"
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  comments     AdminTaskComment[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdById])
  @@index([dueDate])
}

model AdminTaskComment {
  id         String     @id @default(cuid())
  taskId     String
  task       AdminTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  userAvatar String?
  content    String
  createdAt  DateTime   @default(now())

  @@index([taskId])
}

// ==========================================
// NOTIFICATIONS & LIVE ALERTS MODEL
// ==========================================

model AdminNotification {
  id        String     @id @default(cuid())
  userId    String?    // null = global to all owners, or specific userId
  type      String     // ORDER, STOCK, TASK, REVIEW, MESSAGE, SYSTEM
  title     String
  message   String
  link      String?    // /admin/orders, /admin/inventory, /admin/tasks, etc.
  isRead    Boolean    @default(false)
  readAt    DateTime?
  metadata  String?    // JSON extra info (orderId, productId, taskId)
  createdAt DateTime   @default(now())
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

// ==========================================
// INTERNAL TEAM CHAT (WHATSAPP-STYLE) MODEL
// ==========================================

model AdminChatMessage {
  id           String     @id @default(cuid())
  senderId     String
  senderName   String
  senderAvatar String?
  recipientId  String?    // null = GENERAL room, or specific userId
  channel      String     @default("GENERAL") // GENERAL, DIRECT, STOCK, ORDERS
  content      String
  attachments  String?    // JSON string array of URLs
  isRead       Boolean    @default(false)
  readAt       DateTime?
  readBy       String?    @default("[]") // JSON array: [{"userId": "...", "userName": "...", "readAt": "..."}]
  createdAt    DateTime   @default(now())

  sender       AdminUser  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    AdminUser? @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([recipientId])
  @@index([channel])
  @@index([createdAt])
}

// ==========================================
// AD CREATIVES & ADS VAULT (CRÉATIFS PUBS)
// ==========================================

model AdminCreative {
  id           String     @id @default(cuid())
  title        String
  description  String?
  mediaUrl     String
  mediaType    String     @default("IMAGE") // IMAGE, VIDEO
  thumbnailUrl String?
  platform     String     @default("META") // META, TIKTOK, SNAPCHAT, GOOGLE, INFLUENCE, ALL
  aspectRatio  String     @default("9:16") // 9:16, 1:1, 16:9, 4:5
  category     String     @default("UGC") // UGC, UNBOXING, PRODUCT_SHOT, HOOK, TESTIMONIAL, PROMO
  status       String     @default("TESTING") // TESTING, WINNER, ACTIVE, PAUSED, ARCHIVED
  adCopy       String?    // Script, Hook text, primary text
  productSlug  String?    // associated perfume slug
  productName  String?
  createdById  String?
  creatorName  String
  tags         String?    // comma separated tags
  viewsCount   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  creator      AdminUser? @relation("CreatedCreatives", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([platform])
  @@index([category])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

// ==========================================
// EXPENSES & CHARGES (CHARGES & DÉPENSES NAY)
// ==========================================

model AdminExpense {
  id            String     @id @default(cuid())
  title         String     // e.g. "TikTok Ads Campagne Mars", "Hébergement Vercel & Domaine", "Emballages & Packaging"
  category      String     // ADS, HOSTING, SALARY, PACKAGING, LOGISTICS, TOOLS, OFFICE, OTHER
  amount        Float      // Amount in Moroccan Dirhams (MAD)
  date          DateTime   @default(now())
  description   String?
  receiptUrl    String?    // Invoice / Receipt attachment URL
  paymentMethod String     @default("CREDIT_CARD") // CREDIT_CARD, BANK_TRANSFER, CASH, CHECK, OTHER
  recurring     String     @default("ONE_TIME")    // ONE_TIME, MONTHLY, ANNUAL
  createdById   String?
  creatorName   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  creator       AdminUser? @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([date])
  @@index([createdById])
  @@index([createdAt])
}

// ==========================================
// ORDER LIFECYCLE TIMELINE & AUDIT TRAIL
// ==========================================

model OrderTimelineEvent {
  id             String     @id @default(cuid())
  orderId        String
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         String     // CREATED, CONFIRMED, PREPARING, PREPARED, SHIPPED, DELIVERED, CANCELED, REFUSED, RETURNED, CALL_ATTEMPT, NOTE
  title          String     // e.g. "Commande créée", "Confirmée par Sara", "Colis préparé & emballé", "Expédiée avec Amana"
  description    String?    // e.g. "Validée avec client. Joignable sur WhatsApp", "N° suivi: AMN-98472"
  actorId        String?    // AdminUser ID or null if created by client/system
  actorName      String     // e.g. "Boutique en ligne (Client)", "Sara Mansouri", "Youssef El Alami"
  actorRole      String?    // e.g. "CLIENT", "ORDER_CONFIRMATION_AGENT", "ORDER_PREPARATION_AGENT", "OWNER"
  actorAvatar    String?
  carrier        String?    // e.g. "Amana Express", "Cathedis", "Ozon Express", "Livreur Interne"
  trackingNumber String?    // e.g. "AMN-98472"
  attachmentUrl  String?    // Uploaded proof/slip/invoice URL
  attachmentName String?    // File name
  attachmentType String?    // IMAGE, PDF, DOCUMENT
  metadata       String?    // JSON extra data (phone, call result, packaging notes)
  createdAt      DateTime   @default(now())

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// CHAT GROUPS & CHANNELS MODEL
// ==========================================

model AdminChatGroup {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?  @default("MessageSquare") // Icon name or emoji
  color       String?  @default("sky")
  memberIds   String   @default("[]") // JSON string array of AdminUser IDs
  createdById String?
  creatorName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

// ==========================================
// AD PLATFORMS & SPEND TRACKING MODELS
// ==========================================

model AdAccountIntegration {
  id                String          @id @default(cuid())
  platform          String          // META, TIKTOK, GOOGLE, SNAPCHAT, INFLUENCE
  accountName       String?         // e.g. "NAY Parfum Meta Ads", "TikTok Business"
  accountId         String          // e.g. "act_123456789", "adv_987654"
  accessToken       String?
  refreshToken      String?
  pixelId           String?
  currency          String          @default("MAD") // MAD, USD, EUR
  exchangeRateToMAD Float           @default(10.0) // 1 USD = 10 MAD
  status            String          @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR, MOCK_MODE
  autoSyncEnabled   Boolean         @default(true)
  lastSyncAt        DateTime?
  lastSyncStatus    String?         // SUCCESS, FAILED
  errorMessage      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  campaigns         AdCampaign[]
  dailySpends       AdDailySpend[]

  @@unique([platform, accountId])
  @@index([platform])
  @@index([status])
}

model AdCampaign {
  id                 String                @id @default(cuid())
  integrationId      String?
  integration        AdAccountIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  platform           String                // META, TIKTOK, GOOGLE, SNAPCHAT, INFLUENCE
  externalCampaignId String?               // Meta or TikTok campaign ID
  name               String
  status             String                @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED, DRAFT
  objective          String?               // CONVERSIONS, TRAFFIC, LEADS, SALES, AWARENESS
  dailyBudget        Float?                @default(0) // In MAD
  totalBudget        Float?                @default(0)
  totalSpend         Float                 @default(0) // In MAD
  impressions        Int                   @default(0)
  clicks             Int                   @default(0)
  ctr                Float                 @default(0) // %
  cpc                Float                 @default(0) // In MAD
  conversions        Int                   @default(0) // Purchases/Orders
  conversionValue    Float                 @default(0) // Revenue in MAD
  cpa                Float                 @default(0) // Cost per Acquisition in MAD
  roas               Float                 @default(0) // ROAS multiplier
  recommendation     String?               // SCALE, OPTIMIZE, PAUSE, LEARNING
  targetAudience     String?
  startDate          DateTime?
  endDate            DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  dailyMetrics       AdDailySpend[]

  @@index([platform])
  @@index([status])
  @@index([integrationId])
}

model AdDailySpend {
  id               String                @id @default(cuid())
  integrationId    String?
  integration      AdAccountIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         AdCampaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform         String                // META, TIKTOK, GOOGLE, SNAPCHAT, INFLUENCE
  date             DateTime              // Day of spend
  spend            Float                 @default(0) // In MAD
  impressions      Int                   @default(0)
  clicks           Int                   @default(0)
  conversions      Int                   @default(0)
  revenue          Float                 @default(0)
  roas             Float                 @default(0)
  cpa              Float                 @default(0)
  cpc              Float                 @default(0)
  notes            String?
  syncedFromApi    Boolean               @default(false)
  syncedToExpenses Boolean               @default(false)
  expenseId        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([platform])
  @@index([date])
  @@index([campaignId])
}

model Carrier {
  id               String                   @id @default(cuid())
  name             String                   @unique
  code             String                   @unique
  contactPhone     String?
  contactEmail     String?
  defaultFee       Float?                   @default(35)
  payoutTermsDays  Int?                     @default(7)
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  orders           Order[]
  payouts          CarrierPayout[]
  adjustments      CarrierAdjustment[]
  statementImports CarrierStatementImport[]
}

model CarrierPayout {
  id              String                    @id @default(cuid())
  carrierId       String
  carrier         Carrier                   @relation(fields: [carrierId], references: [id])
  reference       String                    @unique
  receivedAt      DateTime                  @default(now())
  amount          Float
  paymentMethod   String                    @default("BANK_TRANSFER") // BANK_TRANSFER, CASH, CHECK, OTHER
  status          String                    @default("CONFIRMED")     // DRAFT, CONFIRMED, CANCELLED
  receiptUrl      String?
  notes           String?
  createdById     String?
  createdByName   String?
  confirmedById   String?
  confirmedByName String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  allocations     CarrierPayoutAllocation[]
  adjustments     CarrierAdjustment[]

  @@index([carrierId])
  @@index([status])
  @@index([receivedAt])
}

model CarrierPayoutAllocation {
  id                 String        @id @default(cuid())
  payoutId           String
  payout             CarrierPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocatedAmount    Float
  carrierFeeDeducted Float         @default(0)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([payoutId, orderId])
  @@index([orderId])
  @@index([payoutId])
}

model CarrierAdjustment {
  id            String         @id @default(cuid())
  carrierId     String
  carrier       Carrier        @relation(fields: [carrierId], references: [id])
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payoutId      String?
  payout        CarrierPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  type          String         // FEE_CORRECTION, RETURN_PENALTY, SHORT_PAYMENT, OVERPAYMENT, DISPUTE, OTHER
  amount        Float          // positive or negative
  reason        String
  createdById   String?
  createdByName String?
  createdAt     DateTime       @default(now())

  @@index([carrierId])
  @@index([orderId])
  @@index([payoutId])
}

model CarrierStatementImport {
  id              String   @id @default(cuid())
  carrierId       String
  carrier         Carrier  @relation(fields: [carrierId], references: [id])
  fileName        String
  fileUrl         String?
  totalRows       Int
  matchedRows     Int
  discrepancyRows Int
  unmatchedRows   Int
  totalAmount     Float
  status          String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  summary         String?  // JSON string
  importedById    String?
  importedByName  String?
  createdAt       DateTime @default(now())

  @@index([carrierId])
  @@index([createdAt])
}

model EncaissementAuditLog {
  id         String   @id @default(cuid())
  action     String   // CREATE_PAYOUT, CONFIRM_PAYOUT, CANCEL_PAYOUT, ALLOCATE, ADJUST, IMPORT_CSV, UPDATE_ORDER_COD
  entityType String   // PAYOUT, ALLOCATION, ORDER, ADJUSTMENT, IMPORT
  entityId   String
  userId     String?
  userName   String
  details    String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}


