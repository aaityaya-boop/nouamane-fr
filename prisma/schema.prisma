  accountId         String          // e.g. "act_123456789", "adv_987654"
  accessToken       String?
  refreshToken      String?
  pixelId           String?
  currency          String          @default("MAD") // MAD, USD, EUR
  exchangeRateToMAD Float           @default(10.0) // 1 USD = 10 MAD
  status            String          @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR, MOCK_MODE
  autoSyncEnabled   Boolean         @default(true)
  lastSyncAt        DateTime?
  lastSyncStatus    String?         // SUCCESS, FAILED
  errorMessage      String?
  createdAt         DateTime        @default(now())
