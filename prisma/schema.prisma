  prompt       String
  language     String   @default("FR")
  country      String   @default("MA")
  category     String?
  targetEntity String   @default("NAY Parfum")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SeoAiMention {
