// ==========================================
// SAV & RÉCLAMATIONS (SERVICE APRÈS-VENTE & RETOURS)
// ==========================================

model ClaimTicket {
  id                   String              @id @default(cuid())
  ticketNumber         String              @unique // e.g. "SAV-2026-0001"
  
  // Relations
  orderId              String
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId           String?
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  // Customer Snapshot Data
  customerName         String
  customerPhone        String?
  customerEmail        String?
  
  // Claim Details
  category             String              // WRONG_PRODUCT, MISSING_PRODUCT, BROKEN_LEAK, DELIVERY_ISSUE, EXCHANGE_REQUEST, RETURN_REQUEST, OTHER
  categoryLabel        String
  channel              String              @default("WHATSAPP") // PHONE, WHATSAPP, EMAIL, OTHER
  priority             String              @default("MEDIUM")   // LOW, MEDIUM, HIGH, URGENT
  status               String              @default("NEW")      // NEW, IN_PROGRESS, PENDING, RESOLVED, CLOSED
  pendingReason        String?             // WAITING_CUSTOMER, WAITING_CARRIER, WAITING_RETURN, INTERNAL_ACTION, OTHER
  description          String              @db.Text
  
  // Affected Products (JSON array of { productId, productName, sku, size, quantity, unitPrice })
  affectedItems        String              @db.Text
  
  // Attachments (JSON array of { id, name, url, type, size, uploadedAt, uploadedByName })
  attachments          String              @default("[]") @db.Text
  
  // Assignee & Ownership
  assignedToId         String?
  assignedToName       String?
  assignedTo           AdminUser?          @relation("AssignedClaims", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById          String?
  createdByName        String
  creator              AdminUser?          @relation("CreatedClaims", fields: [createdById], references: [id], onDelete: SetNull)
  
  // Next Action & Deadlines
  nextAction           String?             // Action à mener
  nextActionDueDate    DateTime?           // Échéance de la prochaine action
  
  // Solutions
  proposedSolution     String?             // ASSISTANCE, SEND_MISSING, REPLACEMENT, EXCHANGE, RETURN, REFUND_PARTIAL, REFUND_TOTAL, REJECTED
  proposedSolutionNotes String?            @db.Text
  solutionStatus       String              @default("NONE") // NONE, PROPOSED, VALIDATED, EXECUTED, REJECTED
  solutionExecutedAt   DateTime?
  solutionExecutedById String?
  solutionExecutedByName String?
  
  // Resolution & Reopening
  resolutionNotes      String?             @db.Text
  resolvedAt           DateTime?
  closedAt             DateTime?
  reopenedAt           DateTime?
  reopenReason         String?             @db.Text
  
  // Timestamps
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  
  // Relations
  events               ClaimEvent[]
  internalNotes        ClaimInternalNote[]
  returnItems          ClaimReturnItem[]
  refunds              ClaimRefund[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedToId])
  @@index([nextActionDueDate])
  @@index([createdAt])
}

model ClaimEvent {
  id          String      @id @default(cuid())
  claimId     String
  claim       ClaimTicket @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actorId     String?
  actorName   String
  actorRole   String?
  type        String      // CREATED, STATUS_CHANGE, ASSIGNED, NOTE_ADDED, ATTACHMENT_ADDED, SOLUTION_PROPOSED, SOLUTION_VALIDATED, RETURN_STATUS_CHANGE, RESTOCK_EXECUTED, REFUND_REQUESTED, REFUND_COMPLETED, REOPENED, CLOSED, OTHER
  title       String
  description String?     @db.Text
  metadata    String?     @db.Text // JSON with old/new values
  createdAt   DateTime    @default(now())

  @@index([claimId])
  @@index([type])
  @@index([createdAt])
}

model ClaimInternalNote {
  id           String      @id @default(cuid())
  claimId      String
  claim        ClaimTicket @relation(fields: [claimId], references: [id], onDelete: Cascade)
  authorId     String?
  authorName   String
  authorAvatar String?
  content      String      @db.Text
  createdAt    DateTime    @default(now())

  @@index([claimId])
  @@index([createdAt])
}

model ClaimReturnItem {
  id                 String      @id @default(cuid())
  claimId            String
  claim              ClaimTicket @relation(fields: [claimId], references: [id], onDelete: Cascade)
  productId          Int?
  productName        String
  sku                String?
  quantity           Int         @default(1)
  
  // Return workflow: RETURN_REQUESTED -> RETURN_RECEIVED (quarantine) -> INSPECTED
  status             String      @default("RETURN_REQUESTED") // RETURN_REQUESTED, RETURN_RECEIVED, INSPECTED
  
  // Inspection decision
  inspectionDecision String?     // RESTOCK_SELLABLE, DAMAGED_DISCARD, NOT_RESALEABLE, OTHER_JUSTIFIED
  inspectionNotes    String?     @db.Text
  inspectedAt        DateTime?
  inspectedById      String?
  inspectedByName    String?
  
  // Restocking (strictly enforced to prevent double restock)
  isRestocked        Boolean     @default(false)
  restockedAt        DateTime?
  restockedQuantity  Int         @default(0)
  restockedById      String?
  restockedByName    String?
  
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([claimId])
  @@index([status])
  @@index([isRestocked])
}

model ClaimRefund {
  id                   String      @id @default(cuid())
  claimId              String
  claim                ClaimTicket @relation(fields: [claimId], references: [id], onDelete: Cascade)
  orderId              String
  amount               Float       // MAD
  reason               String      // Motif du remboursement
  paymentMethod        String      @default("VIREMENT_BANCAIRE") // VIREMENT_BANCAIRE, ESPECES, RECHARGE, CARTE, AUTRE
  transactionReference String?     // Ref bancaire / N° opération
  status               String      @default("PENDING") // PENDING (À effectuer), COMPLETED (Effectué), CANCELLED
  effectiveDate        DateTime?
  receiptUrl           String?
  confirmedById        String?
  confirmedByName      String?
  confirmedAt          DateTime?
  expenseId            String?     // Lié à AdminExpense
  notes                String?     @db.Text
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([claimId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════
// 🧠 CONSEILLER NAY (IA) - INTELLIGENCE CLIENTS & CONVERSATIONS
// ══════════════════════════════════════════════════════════════════
model AdvisorConversation {
  id                 String           @id @default(cuid())
  sessionId          String           // Anonymous visitor token or session ID
  customerName       String?
  customerPhone      String?
  customerCity       String?
  summary            String?          // e.g. "Recherche parfum boisé et vanillé pour homme"
  intent             String           @default("RECOMMENDATION") // RECOMMENDATION, TESTER_INQUIRY, GIFT_SEARCH, PRICE_SHIPPING, SILLAGE_PERFUME, COMPLAINT, GENERAL
  preferredNotes     String?          // JSON array e.g. '["vanille", "oud", "bois de santal"]'
  preferredBrands    String?          // JSON array e.g. '["Tom Ford", "YSL"]'
  preferredGender    String?          // 'HOMME', 'FEMME', 'UNISEXE'
  budget             String?          // e.g. "< 400 MAD", "Master Copy", "Testeur"
  recommendedSlugs   String?          // JSON array e.g. '["baccarat-rouge-540", "tom-ford-oud-wood"]'
  rating             Int?             // Optional 1-5 customer rating on the advice
  status             String           @default("ACTIVE") // ACTIVE, COMPLETED, CONVERTED
  device             String?          // Desktop, Mobile, Tablet
  messagesCount      Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  messages           AdvisorMessage[]

  @@index([sessionId])
  @@index([intent])
  @@index([createdAt])
  @@index([status])
}

model AdvisorMessage {
  id                  String              @id @default(cuid())
  conversationId      String
  conversation        AdvisorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                String              // 'user' | 'assistant' | 'system'
  content             String              @db.Text
  recommendedProducts String?             // JSON array of product references mentioned
  createdAt           DateTime            @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ==========================================
// FOURNISSEURS & APPROVISIONNEMENTS (SUPPLIERS)
// ==========================================

model Supplier {
  id                 String                  @id @default(cuid())
  name               String                  // Nom du fournisseur / labo / importateur
  code               String                  @unique // e.g. "FRN-001"
  category           String                  @default("PARFUMS") // PARFUMS, PACKAGING, ESSENCES, FLACONS, LOGISTIQUE, AUTRE
  tier               String                  @default("TIER_1") // TIER_1 (Stratégique), TIER_2 (Agréé), TIER_3 (Ponctuel)
  contactName        String?                 // Nom du contact principal
  phone              String?                 // Téléphone / WhatsApp
  email              String?
  city               String?                 // Casablanca, Tanger, Dubaï, Grasse, Paris, etc.
  country            String?                 @default("MA")
  address            String?
  taxId              String?                 // ICE / Identifiant Fiscal / RC
  incoterms          String?                 @default("DDP") // DDP Casablanca, CIF Tanger Med, EXW Grasse, FOB Dubaï
  certifications     String?                 @default("[\"IFRA Standard\", \"ISO 22716 BPF\"]") // JSON array
  currency           String                  @default("MAD") // MAD, EUR, USD, AED
  minOrderValueMAD   Float?                  @default(0) // Minimum de commande (MAD)
  paymentTerms       String?                 @default("A_LA_LIVRAISON") // A_LA_LIVRAISON, 30_JOURS, 50_AVANCE, COMPTANT, VIREMENT
  bankName           String?                 // CIH, Attijariwafa, BOA, etc.
  bankRib            String?                 // 24 chiffres RIB
  leadTimeDays       Int                     @default(3) // Délai moyen de livraison en jours
  rating             Float                   @default(5.0) // Note de fiabilité (1 à 5)
  qualityScore       Float                   @default(98.5) // Taux de conformité qualité (%)
  onTimeDeliveryRate Float                   @default(96.0) // Taux de livraison à l'heure OTIF (%)
  status             String                  @default("ACTIVE") // ACTIVE, INACTIVE, VIP, PENDING
  notes              String?                 @db.Text
  totalOrdersCount   Int                     @default(0)
  totalSpendMAD      Float                   @default(0)
  lastOrderDate      DateTime?
  suppliedProducts   String?                 @default("[]") // JSON array of product slugs / names
  pricingList        String?                 @db.Text @default("[]") // JSON array of negotiated SKU catalog
  contractUrl        String?
  purchaseOrders     SupplierPurchaseOrder[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([category])
  @@index([tier])
  @@index([status])
  @@index([city])
}

model SupplierPurchaseOrder {
  id                      String    @id @default(cuid())
  orderNumber             String    @unique // e.g. "BC-2026-001"
  supplierId              String
  supplier                Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items                   String    @db.Text // JSON array: [{ name, quantity, unitCost, totalCost, sku, notes }]
  subtotalAmountMAD       Float     @default(0)
  shippingCostMAD         Float     @default(0)
  taxAmountMAD            Float     @default(0)
  totalAmount             Float     @default(0) // Total amount in MAD (si chiffré)
  chargeAmountMAD         Float?    @default(0) // Montant réel de la charge fournisseur
  currency                String    @default("MAD")
  status                  String    @default("PENDING") // DRAFT, PENDING, CONFIRMED, IN_TRANSIT, RECEIVED, CANCELLED
  paymentStatus           String    @default("UNPAID") // UNPAID (Non Payé), PARTIAL (Acompte), PAID (Payé)
  paidAmount              Float     @default(0)
  paymentMethod           String?   @default("VIREMENT") // VIREMENT, ESPECES, CHEQUE, EFFET, AUTRE
  paymentDueDate          DateTime?
  paidAt                  DateTime?
  carrierName             String?   // CTM Messagerie, Amana Express, SDTM, Fret Aérien, Transporteur Privé
  trackingNumber          String?   // N° Expédition / Suivi
  invoiceNumber           String?   // Numéro de facture fournisseur
  invoiceUrl              String?   // Lien vers justificatif / bon de livraison
  receiptUrl              String?   // Photo / Scan du Reçu de paiement ou Bon de réception
  qualityInspectionStatus String    @default("PENDING") // PENDING, PASSED, PASSED_WITH_RESERVATIONS, REJECTED
  qualityInspectionNotes  String?   @db.Text
  deliveryExpectedAt      DateTime?
  receivedAt              DateTime?
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// ==========================================
// SUGGESTIONS D'EMPLOYÉS (BOÎTE À IDÉES & INNOVATION)
// ==========================================

model EmployeeSuggestion {
  id            String     @id @default(cuid())
  title         String
  description   String     @db.Text
  category      String     // SALES_BOOST, LOGISTICS_PACKAGING, MARKETING_ADS, PRODUCT_CURATION, CUSTOMER_EXP, WORK_ENVIRONMENT, COST_SAVINGS, DIGITAL_TECH, OTHER
  impact        String     @default("MEDIUM") // LOW, MEDIUM, HIGH, GAME_CHANGER
  status        String     @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, IN_PROGRESS, IMPLEMENTED, REJECTED
  isAnonymous   Boolean    @default(false)
  
  authorId      String?
  author        AdminUser? @relation("EmployeeSuggestions", fields: [authorId], references: [id], onDelete: SetNull)
  authorName    String
  authorRole    String?
  authorAvatar  String?
  
  likesCount    Int        @default(0)
  likedBy       String     @default("[]") @db.Text // JSON array of admin user IDs
  attachments   String     @default("[]") @db.Text // JSON array of uploaded pictures/documents
  
  adminFeedback String?    @db.Text
  rewardNotes   String?    // e.g. "Prime d'innovation 500 MAD"
  implementedAt DateTime?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([category])
  @@index([authorId])
  @@index([createdAt])
}

// ==========================================
// RÉCLAMATIONS & SIGNALEMENTS RH DES EMPLOYÉS
// ==========================================

model EmployeeReclamation {
  id              String     @id @default(cuid())
  ticketNumber    String     @unique // e.g. "REC-2026-001"
  subject         String
  description     String     @db.Text
  category        String     // EQUIPMENT_TOOLS, WORK_ENVIRONMENT, REMUNERATION_BONUS, SCHEDULE_WORKLOAD, MEDIATION_RELATIONS, HEALTH_SAFETY, LOGISTICS_STOCK, OTHER
  priority        String     @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  confidentiality String     @default("STANDARD") // STANDARD, CONFIDENTIAL_OWNER, ANONYMOUS
  status          String     @default("OPEN") // OPEN, IN_REVIEW, ACTION_TAKEN, RESOLVED, REJECTED
  isAnonymous     Boolean    @default(false)
  
  authorId        String?
  author          AdminUser? @relation("EmployeeReclamations", fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String
  authorRole      String?
  authorPhone     String?
  authorAvatar    String?
  
  attachments     String     @default("[]") @db.Text // JSON array of file/photo URLs
  
  assignedToId    String?
  assignedTo      AdminUser? @relation("AssignedReclamations", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToName  String?
  
  resolutionNotes String?    @db.Text
  actionPlan      String?    @db.Text
  resolvedAt      DateTime?
  resolvedByName  String?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([authorId])
  @@index([createdAt])
}



