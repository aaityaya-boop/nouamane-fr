  clicks             Int                   @default(0)
  ctr                Float                 @default(0) // %
  cpc                Float                 @default(0) // In MAD
  conversions        Int                   @default(0) // Purchases/Orders
  conversionValue    Float                 @default(0) // Revenue in MAD
  cpa                Float                 @default(0) // Cost per Acquisition in MAD
  roas               Float                 @default(0) // ROAS multiplier
