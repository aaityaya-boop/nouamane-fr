// ==========================================
// MULTI-OWNER & ADMIN AUTHENTICATION MODELS
// ==========================================

model AdminUser {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  passwordHash      String
  avatar            String?
  role              String              @default("OWNER")
  jobTitle          String?
  phone             String?
  status            String              @default("ACTIVE") // ACTIVE, DISABLED
  salary            Float?              @default(0) // Salary in Moroccan Dirhams (MAD)
  salaryType        String?             @default("MONTHLY") // MONTHLY, COMMISSION, HOURLY
  customPermissions String?             // JSON: { granted: string[], revoked: string[] }
  lastLoginAt       DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  activities        AdminActivityLog[]
  createdTasks      AdminTask[]         @relation("CreatedTasks")
  assignedTasks     AdminTask[]         @relation("AssignedTasks")
  createdClaims     ClaimTicket[]       @relation("CreatedClaims")
  assignedClaims    ClaimTicket[]       @relation("AssignedClaims")
  taskComments      AdminTaskComment[]
  notifications     AdminNotification[]
  sentMessages      AdminChatMessage[]  @relation("SentMessages")
  receivedMessages  AdminChatMessage[]  @relation("ReceivedMessages")
  createdCreatives  AdminCreative[]     @relation("CreatedCreatives")
  createdExpenses   AdminExpense[]      @relation("CreatedExpenses")
  employeeSuggestions EmployeeSuggestion[] @relation("EmployeeSuggestions")
  employeeReclamations EmployeeReclamation[] @relation("EmployeeReclamations")
  assignedReclamations EmployeeReclamation[] @relation("AssignedReclamations")
  pushSubscriptions    AdminPushSubscription[]
  notificationPreferences AdminNotificationPreference?

  @@index([email])
  @@index([role])
  @@index([status])
}

model AdminActivityLog {
  id          String     @id @default(cuid())
  userId      String?
  userName    String
  userEmail   String?
  action      String     // LOGIN, LOGOUT, CREATE_PRODUCT, UPDATE_PRODUCT, DELETE_PRODUCT, UPDATE_ORDER, CREATE_TASK, UPDATE_TASK, etc.
  entityType  String     // PRODUCT, ORDER, REVIEW, CUSTOMER, BRAND, USER, TASK, SYSTEM
  entityId    String?
  description String
  oldValue    String?
  newValue    String?
  ipAddress   String?
  createdAt   DateTime   @default(now())
  user        AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

// ==========================================
// MISSIONS & TASKS MODELS (GESTION DES TÂCHES)
// ==========================================

model AdminTask {
  id           String             @id @default(cuid())
  title        String
  description  String?
  priority     String             @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
